# E2E test mode: a fictional Google client so browser tests run the required
# sign-in against the fake Google served by tests/browser/google-fixture.ts.
# Overrides .env.local because a .env.[mode] file takes priority. No secrets here.
VITE_GOOGLE_CLIENT_ID=123-e2e.apps.googleusercontent.com
VITE_ALLOWED_EMAIL_DOMAINS=g.kogakuin.jp
